{
  "name": "@th3-plug/shell",
  "version": "1.2.0",
  "private": true,
  "description": "Run a local shell command from the DeepSeek Harness composer with ! or /sh, without calling the AI agent, with zsh completions and history suggestions while typing.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./host/index.js",
    "./client": "./web/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/*.js",
    "host/*.zsh",
    "web/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
