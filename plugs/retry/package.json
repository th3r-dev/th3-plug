{
  "name": "@th3-plug/retry",
  "version": "0.1.2",
  "private": true,
  "description": "Retry and edit a previous prompt from the assistant's action row, with the original images re-sent, and fit every oversized image to the provider's dimension cap so a many-image request stops failing.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "retry",
    "image",
    "downscale"
  ],
  "homepage": "https://github.com/th3r-dev/th3-plug/tree/main/plugs/retry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th3r-dev/th3-plug.git",
    "directory": "plugs/retry"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./host/index.js",
    "./client": "./web/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/*.js",
    "web/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
