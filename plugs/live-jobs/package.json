{
  "name": "@th3-plug/live-jobs",
  "version": "0.3.0",
  "private": true,
  "description": "See the background jobs the agent starts without leaving the conversation: the real command, streaming output, exit status, and a stop button.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./host/index.js",
    "./client": "./web/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/*.js",
    "web/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "jobs",
    "background",
    "bash",
    "terminal"
  ],
  "homepage": "https://github.com/th3r-dev/th3-plug/tree/main/plugs/live-jobs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th3r-dev/th3-plug.git",
    "directory": "plugs/live-jobs"
  }
}
